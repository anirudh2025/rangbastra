---
import LoomFallback from "../../components/hero/LoomFallback.astro";
import Button from "../../components/primitives/Button.astro";
import Label from "../../components/primitives/Label.astro";
---

<header
  class="living-hero"
  data-hero-root
  data-hero-mode="static"
  data-hero-state="BOOT"
  aria-labelledby="hero-heading"
>
  <div class="living-hero__stage">
    <LoomFallback />

    <div
      class="living-hero__enhancement"
      data-hero-enhancement
      aria-hidden="true"
    ></div>

    <button
      class="living-hero__pull"
      type="button"
      data-hero-pull-control
      aria-label="Pull the couture thread to reveal the textile"
    >
      <span class="living-hero__pull-handle" aria-hidden="true"></span>
      <span class="living-hero__pull-label">Pull to reveal</span>
    </button>

    <div class="living-hero__content" data-hero-content>
      <p class="living-hero__eyebrow">Bespoke Indian Couture</p>
      <h1 id="hero-heading">Not Designed for Everyone</h1>
      <div class="living-hero__actions">
        <Button href="/design-your-outfit" class="living-hero__primary">
          <Label icon="sketch">Begin Yours</Label>
        </Button>
        <a class="living-hero__secondary" href="/collections">
          <Label icon="journal">Explore the Collection</Label>
        </a>
      </div>
    </div>

    <div class="living-hero__handoff" data-hero-handoff aria-hidden="true">
      <svg viewBox="0 0 1440 150" preserveAspectRatio="none">
        <path d="M160 0 C 310 54, 420 45, 560 150" />
        <path d="M712 0 C 690 58, 746 93, 720 150" />
        <path d="M1260 0 C 1120 55, 1045 62, 920 150" />
      </svg>
    </div>
  </div>
</header>

<script>
  import {
    disposeHeroController,
    initHeroController,
  } from "../../lib/hero/controller";

  document.addEventListener("astro:page-load", initHeroController);
  document.addEventListener("astro:before-swap", disposeHeroController);
  initHeroController();
</script>

<style>
  .living-hero {
    position: relative;
    height: 100svh;
    min-height: 38rem;
    overflow: hidden;
    background: #000;
    color: var(--text-primary);
    isolation: isolate;
  }

  .living-hero__stage {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .living-hero__enhancement {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 760ms var(--ease-luxury);
  }

  :global([data-hero-fallback]) {
    opacity: 1;
    transition: opacity 920ms var(--ease-luxury);
  }

  .living-hero[data-hero-enhanced-ready="true"] .living-hero__enhancement {
    opacity: 1;
  }

  .living-hero[data-hero-enhanced-ready="true"] :global(
      [data-hero-fallback]
    ) {
    opacity: 0;
  }

  .living-hero__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: min(76rem, calc(100% - 4rem));
    height: 100%;
    margin-inline: auto;
    padding: clamp(7rem, 13vh, 10rem) 0 5rem;
    text-align: center;
  }

  .living-hero__pull {
    display: none;
  }

  .living-hero__eyebrow {
    margin: 0 0 clamp(1.35rem, 3vh, 2.25rem);
    color: var(--sand-200);
    font-family: var(--font-ceremonial);
    font-size: var(--caption);
    font-weight: 400;
    letter-spacing: .7em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--ivory-100);
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 5.25vw, 5.125rem);
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.035em;
    text-wrap: balance;
    text-shadow: 0 6px 42px rgba(0, 0, 0, .88);
  }

  .living-hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    margin-top: clamp(var(--space-7), 5vh, var(--space-9));
  }

  :global(.living-hero__primary) {
    min-height: 56px;
    border-color: var(--cocoa-border);
    border-radius: var(--radius-md);
    background: var(--gradient-obsidian);
  }

  .living-hero__secondary {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: .75rem .1rem;
    color: var(--ivory-100);
    font-size: var(--label-md);
  }

  .living-hero__secondary::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: .3rem;
    left: 0;
    height: 1px;
    background: var(--gradient-gold);
    transform: scaleX(.22);
    transform-origin: left;
    transition: transform var(--motion-medium) var(--ease-luxury);
  }

  .living-hero__secondary:hover::after,
  .living-hero__secondary:focus-visible::after {
    transform: scaleX(1);
  }

  .living-hero__secondary:focus-visible {
    border-radius: var(--radius-sm);
    outline: 1px solid var(--cocoa-300);
    outline-offset: 5px;
  }

  .living-hero__handoff {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    height: clamp(5rem, 14vh, 9rem);
    background: linear-gradient(to bottom, transparent, var(--surface-canvas));
    pointer-events: none;
  }

  .living-hero__handoff svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: calc(var(--hero-unravel, 0) * .72);
  }

  .living-hero__handoff path {
    fill: none;
    stroke: rgba(139, 94, 61, .42);
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--hero-unravel, 0));
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  :global(html[data-hero-pointer-owner="living-loom"] .global-cursor-glow) {
    opacity: 0 !important;
  }

  @media (max-width: 700px), (orientation: portrait) {
    .living-hero[data-hero-mode="silk-portal"][data-hero-pull-ready="true"]
      .living-hero__pull {
      position: absolute;
      top: 30%;
      left: 50%;
      z-index: 4;
      display: grid;
      min-width: 5.5rem;
      min-height: 6.5rem;
      place-items: start center;
      border: 0;
      background: transparent;
      color: rgba(231, 211, 184, .76);
      font: inherit;
      touch-action: none;
      transform: translate(-50%, calc(var(--hero-pull-progress, 0) * 9rem));
      transition: opacity 300ms ease;
    }

    .living-hero__pull-handle {
      display: block;
      width: 1.7rem;
      height: 1.7rem;
      border: 1px solid rgba(202, 163, 111, .62);
      border-radius: 50%;
      background:
        radial-gradient(circle, rgba(226, 197, 155, .52) 0 8%, transparent 10%),
        rgba(12, 8, 7, .76);
      box-shadow: 0 0 0 .45rem rgba(123, 80, 52, .08);
    }

    .living-hero__pull-label {
      margin-top: .7rem;
      font-family: var(--font-ceremonial);
      font-size: .58rem;
      letter-spacing: .22em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .living-hero[data-hero-state="COMPLETE"] .living-hero__pull {
      opacity: 0;
      pointer-events: none;
    }

    .living-hero__content {
      justify-content: flex-end;
      width: calc(100% - 2rem);
      padding: calc(var(--navbar-height) + 4rem) 0 clamp(5.5rem, 13vh, 7.5rem);
    }

    .living-hero__eyebrow {
      margin-bottom: 1rem;
      font-size: .61rem;
      letter-spacing: .48em;
    }

    h1 {
      max-width: 12ch;
      font-size: clamp(2.25rem, 10vw, 3.4rem);
      line-height: .98;
    }

    .living-hero__actions {
      flex-direction: column;
      gap: .35rem;
      margin-top: var(--space-6);
    }

    :global(.living-hero__primary) {
      min-height: 48px;
      font-size: .76rem;
    }

    .living-hero__secondary {
      font-size: .76rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .living-hero,
    .living-hero *,
    .living-hero *::before,
    .living-hero *::after {
      animation: none !important;
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>
