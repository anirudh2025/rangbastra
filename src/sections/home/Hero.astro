---
import LoomFallback from "../../components/hero/LoomFallback.astro";
import Button from "../../components/primitives/Button.astro";
import Label from "../../components/primitives/Label.astro";
---

<header
  class="living-hero"
  data-hero-root
  data-hero-mode="static"
  data-hero-state="BOOT"
  aria-labelledby="hero-heading"
>
  <div class="living-hero__stage" data-hero-stage>
    <LoomFallback />

    <div
      class="living-hero__enhancement"
      data-hero-enhancement
      aria-hidden="true"
    ></div>

    <div class="living-hero__content" data-hero-content>
      <p class="living-hero__eyebrow">Bespoke Indian Couture</p>
      <h1 id="hero-heading">Not Designed for Everyone</h1>
      <div class="living-hero__actions">
        <Button href="/design-your-outfit" class="living-hero__primary">
          <Label icon="sketch">Begin Yours</Label>
        </Button>
        <a class="living-hero__secondary" href="/collections">
          <Label icon="journal">Explore the Collection</Label>
        </a>
      </div>
    </div>

    <div class="living-hero__handoff" data-hero-handoff aria-hidden="true"></div>
  </div>
</header>

<script>
  import {
    disposeHeroController,
    initHeroController,
  } from "../../lib/hero/controller";

  document.addEventListener("astro:page-load", initHeroController);
  document.addEventListener("astro:before-swap", disposeHeroController);
  initHeroController();
</script>

<style>
  .living-hero {
    position: relative;
    height: 210svh;
    min-height: 38rem;
    overflow: visible;
    background: #000;
    color: var(--text-primary);
    isolation: isolate;
  }

  .living-hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .living-hero[data-hero-ready="true"][data-hero-mode="static"] {
    height: 100svh;
  }

  .living-hero__enhancement {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 760ms var(--ease-luxury);
  }

  :global([data-hero-fallback]) {
    opacity: 1;
    transition: opacity 920ms var(--ease-luxury);
  }

  .living-hero[data-hero-enhanced-ready="true"] .living-hero__enhancement {
    opacity: 1;
  }

  .living-hero[data-hero-enhanced-ready="true"] :global(
      [data-hero-fallback]
    ) {
    opacity: 0;
  }

  .living-hero__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: min(76rem, calc(100% - 4rem));
    height: 100%;
    margin-inline: auto;
    padding: clamp(7rem, 13vh, 10rem) 0 5rem;
    text-align: center;
  }

  .living-hero__eyebrow {
    margin: 0 0 clamp(1.35rem, 3vh, 2.25rem);
    color: var(--sand-200);
    font-family: var(--font-ceremonial);
    font-size: var(--caption);
    font-weight: 400;
    letter-spacing: .7em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--ivory-100);
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 5.25vw, 5.125rem);
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.035em;
    text-wrap: balance;
    text-shadow: 0 6px 42px rgba(0, 0, 0, .88);
  }

  .living-hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    margin-top: clamp(var(--space-7), 5vh, var(--space-9));
  }

  :global(.living-hero__primary) {
    min-height: 56px;
    border-color: var(--cocoa-border);
    border-radius: var(--radius-md);
    background: var(--gradient-obsidian);
  }

  .living-hero__secondary {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: .75rem .1rem;
    color: var(--ivory-100);
    font-size: var(--label-md);
  }

  .living-hero__secondary::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: .3rem;
    left: 0;
    height: 1px;
    background: var(--gradient-gold);
    transform: scaleX(.22);
    transform-origin: left;
    transition: transform var(--motion-medium) var(--ease-luxury);
  }

  .living-hero__secondary:hover::after,
  .living-hero__secondary:focus-visible::after {
    transform: scaleX(1);
  }

  .living-hero__secondary:focus-visible {
    border-radius: var(--radius-sm);
    outline: 1px solid var(--cocoa-300);
    outline-offset: 5px;
  }

  .living-hero__handoff {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    height: clamp(5rem, 14vh, 9rem);
    background: linear-gradient(to bottom, transparent, var(--surface-canvas));
    pointer-events: none;
  }

  :global(html[data-hero-pointer-owner="living-loom"] .global-cursor-glow) {
    opacity: 0 !important;
  }

  @media (max-width: 700px), (orientation: portrait) {
    .living-hero {
      height: 195svh;
    }

    .living-hero__content {
      justify-content: flex-end;
      width: calc(100% - 2rem);
      padding: calc(var(--navbar-height) + 4rem) 0 clamp(5.5rem, 13vh, 7.5rem);
    }

    .living-hero__eyebrow {
      margin-bottom: 1rem;
      font-size: .61rem;
      letter-spacing: .48em;
    }

    h1 {
      max-width: 12ch;
      font-size: clamp(2.25rem, 10vw, 3.4rem);
      line-height: .98;
    }

    .living-hero__actions {
      flex-direction: column;
      gap: .35rem;
      margin-top: var(--space-6);
    }

    :global(.living-hero__primary) {
      min-height: 48px;
      font-size: .76rem;
    }

    .living-hero__secondary {
      font-size: .76rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .living-hero,
    .living-hero *,
    .living-hero *::before,
    .living-hero *::after {
      animation: none !important;
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>

<noscript>
  <style>
    .living-hero { height: 100svh !important; }
  </style>
</noscript>
