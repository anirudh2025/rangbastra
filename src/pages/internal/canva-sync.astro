---
const syncProducts = Object.freeze([
  Object.freeze({ slug: "gulnaar", label: "Gulnaar" }),
  Object.freeze({ slug: "elara", label: "Elara" }),
  Object.freeze({ slug: "noor", label: "Noor" }),
  Object.freeze({ slug: "inaayat", label: "Inaayat" }),
  Object.freeze({ slug: "amaira", label: "Amaira" }),
  Object.freeze({ slug: "naeyra", label: "Naeyra" }),
  Object.freeze({ slug: "mahira", label: "Mahira" }),
  Object.freeze({ slug: "ayana", label: "Ayana" }),
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Canva Sync | Rangbastra</title>
  </head>
  <body>
    <main>
      <h1>Canva Product Sync</h1>
      <p>Choose one approved product to sync from Canva to Cloudinary.</p>

      <form data-sync-form>
        <label for="sync-secret">Sync Secret</label>
        <input
          id="sync-secret"
          name="sync-secret"
          type="password"
          autocomplete="off"
          required
        />

        <div class="sync-actions">
          {
            syncProducts.map(({ slug, label }) => (
              <button
                type="submit"
                name="product"
                value={slug}
                data-sync-button
              >
                Sync {label}
              </button>
            ))
          }
        </div>
      </form>

      <section aria-live="polite" aria-atomic="true">
        <h2>Status</h2>
        <pre data-sync-result>Ready.</pre>
      </section>
    </main>

    <script>
      const form = document.querySelector("[data-sync-form]");
      const secretInput = document.querySelector("#sync-secret");
      const buttons = [
        ...document.querySelectorAll("[data-sync-button]"),
      ];
      const result = document.querySelector("[data-sync-result]");

      if (
        !(form instanceof HTMLFormElement) ||
        !(secretInput instanceof HTMLInputElement) ||
        !(result instanceof HTMLElement)
      ) {
        throw new Error("Canva sync controls are unavailable.");
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitter =
          event instanceof SubmitEvent &&
          event.submitter instanceof HTMLButtonElement
            ? event.submitter
            : null;
        const product = submitter?.value ?? "";
        const productLabel = submitter?.textContent?.replace(/^Sync\s+/, "") ?? product;
        const secret = secretInput.value;

        if (!product || !secret) {
          result.textContent = "Choose a product and enter the sync secret.";
          return;
        }

        buttons.forEach((button) => {
          if (button instanceof HTMLButtonElement) button.disabled = true;
        });
        result.textContent = `Synchronizing ${productLabel}...`;

        try {
          const response = await fetch(
            `/api/canva/sync?product=${encodeURIComponent(product)}`,
            {
              method: "POST",
              headers: {
                Authorization: `Bearer ${secret}`,
              },
            },
          );
          const payload = await response.json().catch(() => ({
            error: "The sync endpoint returned an unreadable response.",
          }));

          result.textContent = JSON.stringify(payload, null, 2);
          result.dataset.status = response.ok ? "success" : "error";
        } catch {
          result.textContent = JSON.stringify(
            { error: "The sync request could not be completed." },
            null,
            2,
          );
          result.dataset.status = "error";
        } finally {
          secretInput.value = "";
          buttons.forEach((button) => {
            if (button instanceof HTMLButtonElement) button.disabled = false;
          });
        }
      });
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: #111;
        color: #f5f0e8;
        font-family: system-ui, sans-serif;
      }

      main {
        width: min(42rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 3rem 0;
      }

      form {
        display: grid;
        gap: 0.75rem;
        margin: 2rem 0;
      }

      input,
      button {
        min-height: 2.75rem;
        border: 1px solid #8f7652;
        border-radius: 0.25rem;
        font: inherit;
      }

      input {
        padding: 0.65rem 0.75rem;
        background: #191919;
        color: inherit;
      }

      .sync-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin-top: 0.5rem;
      }

      button {
        padding: 0.65rem 1rem;
        background: #8f7652;
        color: #fff;
        cursor: pointer;
      }

      button:disabled {
        cursor: wait;
        opacity: 0.65;
      }

      pre {
        overflow-wrap: anywhere;
        white-space: pre-wrap;
        padding: 1rem;
        border: 1px solid #40382d;
        background: #181818;
      }

      pre[data-status="success"] {
        border-color: #507453;
      }

      pre[data-status="error"] {
        border-color: #9b4f4f;
      }

      @media (max-width: 36rem) {
        .sync-actions {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
