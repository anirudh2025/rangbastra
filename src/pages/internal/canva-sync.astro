---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/primitives/Container.astro";
import Section from "../../components/primitives/Section.astro";
---

<BaseLayout
  title="Canva Sync | Rangbastra Internal"
  description="Internal Rangbastra Canva synchronization control."
  canonical="/internal/canva-sync"
  robots="noindex,nofollow"
>
  <Section class="sync-section">
    <Container class="sync-container">
      <article class="sync-panel">
        <header>
          <p>Internal operator tool</p>
          <h1>Canva Sync</h1>
        </header>

        <form data-sync-form autocomplete="off">
          <label for="sync-secret">Sync Secret</label>
          <input
            id="sync-secret"
            name="sync-secret"
            type="password"
            autocomplete="off"
            required
          />
          <button type="submit" data-sync-button>Sync Gulnaar</button>
        </form>

        <section class="sync-result" aria-live="polite" aria-atomic="true">
          <h2>Status</h2>
          <pre data-sync-result>Ready.</pre>
        </section>
      </article>
    </Container>
  </Section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-sync-form]");
  const secretInput =
    document.querySelector<HTMLInputElement>("#sync-secret");
  const button =
    document.querySelector<HTMLButtonElement>("[data-sync-button]");
  const result = document.querySelector<HTMLElement>("[data-sync-result]");

  const clearSecret = () => {
    if (secretInput) secretInput.value = "";
  };

  clearSecret();
  window.addEventListener("pageshow", clearSecret);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!secretInput || !button || !result || !secretInput.value) return;

    button.disabled = true;
    result.dataset.state = "pending";
    result.textContent = "Synchronizing Gulnaar…";

    try {
      const response = await fetch("/api/canva/sync?product=gulnaar", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${secretInput.value}`,
        },
        cache: "no-store",
        credentials: "same-origin",
      });

      let payload;
      try {
        payload = await response.json();
      } catch {
        payload = { error: "The sync endpoint returned an invalid response." };
      }

      result.dataset.state = response.ok ? "success" : "error";
      result.textContent = JSON.stringify(payload, null, 2);
    } catch {
      result.dataset.state = "error";
      result.textContent = JSON.stringify({
        error: "The sync request could not be completed.",
      });
    } finally {
      clearSecret();
      button.disabled = false;
    }
  });
</script>

<style>
  :global(.sync-section) {
    min-height: 100vh;
    padding-block: clamp(var(--space-11), 14vw, var(--space-14));
  }

  :global(.sync-container) {
    --container-default: 44rem;
  }

  .sync-panel,
  form,
  .sync-result {
    display: grid;
    gap: var(--space-4);
  }

  .sync-panel {
    gap: var(--space-7);
    padding: clamp(var(--space-5), 5vw, var(--space-8));
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    background: var(--surface-raised);
  }

  header {
    display: grid;
    gap: var(--space-2);
  }

  header p,
  label,
  h2 {
    color: var(--text-muted);
    font-size: var(--caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  h1 {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: var(--weight-light);
  }

  input,
  button {
    min-height: 3rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding-inline: var(--space-4);
    font: inherit;
  }

  input {
    background: var(--surface-canvas);
    color: var(--text-primary);
  }

  button {
    background: rgb(var(--cocoa-rgb));
    color: var(--ivory-50);
    cursor: pointer;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  pre {
    min-height: 8rem;
    overflow: auto;
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-canvas);
    color: var(--text-secondary);
    font-size: var(--body-sm);
    line-height: var(--leading-body);
    white-space: pre-wrap;
    word-break: break-word;
  }

  pre[data-state="success"] {
    border-color: var(--cocoa-border-strong);
    color: var(--text-primary);
  }

  pre[data-state="error"] {
    border-color: var(--error);
  }
</style>
