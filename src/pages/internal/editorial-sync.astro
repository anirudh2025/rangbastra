---
import { EDITORIAL_SYNC_ASSETS } from "../../data/editorialAssets.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Editorial Asset Sync | Rangbastra</title>
  </head>
  <body>
    <main>
      <header>
        <p>Rangbastra Internal</p>
        <h1>Editorial Assets</h1>
        <span>Replace approved Canva artwork, then sync the selected asset.</span>
      </header>

      <form data-sync-form>
        <label for="sync-secret">Sync Secret</label>
        <input id="sync-secret" type="password" autocomplete="off" required />
        <div class="actions">
          <button type="button" data-sync-all>Sync All</button>
          <button type="button" data-refresh>Refresh Status</button>
        </div>
      </form>

      <p class="configuration" data-configuration aria-live="polite">Loading editorial asset status…</p>
      <section class="asset-grid" aria-label="Editorial assets">
        {EDITORIAL_SYNC_ASSETS.map((asset) => (
          <article data-asset={asset.key}>
            <div class="preview"><img src={asset.url} alt="" loading="lazy" decoding="async" data-preview /></div>
            <div class="content">
              <h2>{asset.label}</h2>
              <dl>
                <div><dt>Current status</dt><dd data-status>Checking…</dd></div>
                <div><dt>Last sync</dt><dd data-last-sync>Not recorded</dd></div>
                <div><dt>Canva page</dt><dd data-canva-page>Checking…</dd></div>
                <div><dt>Native dimensions</dt><dd data-dimensions>Checking…</dd></div>
                <div><dt>Cloudinary target</dt><dd data-public-id>Checking…</dd></div>
              </dl>
              <button type="button" data-sync-asset={asset.key}>Sync {asset.label}</button>
            </div>
          </article>
        ))}
      </section>
      <pre data-result aria-live="polite">Ready.</pre>
    </main>

    <script>
      // @ts-nocheck
      const form = document.querySelector("[data-sync-form]");
      const secretInput = document.querySelector("#sync-secret");
      const result = document.querySelector("[data-result]");
      const configuration = document.querySelector("[data-configuration]");
      const refresh = document.querySelector("[data-refresh]");
      const syncAll = document.querySelector("[data-sync-all]");
      const assetButtons = [...document.querySelectorAll("[data-sync-asset]")];

      const setBusy = (busy) => {
        [...assetButtons, refresh, syncAll].forEach((element) => {
          if (element instanceof HTMLButtonElement) element.disabled = busy;
        });
      };
      const formatDate = (value) => value ? new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" }).format(new Date(value)) : "Not recorded";
      const readableStatus = (asset) => {
        if (!asset.canvaPageConfigured) return "Missing Canva page";
        if (asset.cloudinary.status === "missing") return "Missing Cloudinary asset";
        if (asset.cloudinary.status === "available") return "Ready";
        return "Cloudinary status unavailable";
      };
      const loadStatus = async () => {
        const response = await fetch("/api/canva/editorial-status", { cache: "no-store" });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || "Editorial status could not be loaded.");
        configuration.textContent = payload.canva === "configured" && payload.cloudinary === "configured"
          ? "Canva and Cloudinary are configured."
          : "Configuration required: set the editorial Canva design/page bindings and matching Cloudinary cloud before syncing.";
        payload.assets.forEach((asset) => {
          const card = document.querySelector(`[data-asset="${asset.key}"]`);
          if (!card) return;
          const status = card.querySelector("[data-status]");
          const lastSync = card.querySelector("[data-last-sync]");
          const canvaPage = card.querySelector("[data-canva-page]");
          const dimensions = card.querySelector("[data-dimensions]");
          const publicId = card.querySelector("[data-public-id]");
          if (status) status.textContent = readableStatus(asset);
          if (lastSync) lastSync.textContent = formatDate(asset.cloudinary.updatedAt);
          if (canvaPage) canvaPage.textContent = asset.canvaPageId || "Missing Canva page";
          if (dimensions) dimensions.textContent = `${asset.expectedDimensions.width} × ${asset.expectedDimensions.height}${asset.actualDimensions ? ` (detected ${asset.actualDimensions.width} × ${asset.actualDimensions.height})` : ""}`;
          if (publicId) publicId.textContent = asset.publicId;
        });
      };
      const syncAsset = async (key, secret) => {
        const response = await fetch(`/api/canva/editorial-sync?asset=${encodeURIComponent(key)}`, {
          method: "POST",
          headers: { Authorization: `Bearer ${secret}` },
        });
        const payload = await response.json().catch(() => ({ error: "The sync endpoint returned an unreadable response." }));
        if (!response.ok) throw new Error(payload.error || "Editorial sync failed.");
        return payload;
      };
      const run = async (keys) => {
        if (!(secretInput instanceof HTMLInputElement) || !secretInput.value) {
          result.textContent = "Enter the sync secret.";
          return;
        }
        const secret = secretInput.value;
        secretInput.value = "";
        setBusy(true);
        try {
          const outcomes = [];
          for (const key of keys) {
            result.textContent = `Synchronizing ${key}…`;
            outcomes.push(await syncAsset(key, secret));
          }
          result.textContent = JSON.stringify(outcomes, null, 2);
          await loadStatus();
        } catch (error) {
          result.textContent = error instanceof Error ? error.message : "Editorial sync failed.";
        } finally {
          setBusy(false);
        }
      };
      assetButtons.forEach((button) => button.addEventListener("click", () => run([button.dataset.syncAsset || ""])));
      syncAll?.addEventListener("click", () => run(assetButtons.map((button) => button.dataset.syncAsset || "").filter(Boolean)));
      refresh?.addEventListener("click", () => loadStatus().catch((error) => { result.textContent = error instanceof Error ? error.message : "Editorial status could not be loaded."; }));
      form?.addEventListener("submit", (event) => event.preventDefault());
      loadStatus().catch((error) => { result.textContent = error instanceof Error ? error.message : "Editorial status could not be loaded."; });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; background: #111; color: #f5f0e8; font-family: system-ui, sans-serif; }
  main { width: min(76rem, calc(100% - 2rem)); margin: 0 auto; padding: 3rem 0 4rem; }
  header { display: grid; gap: .6rem; max-width: 44rem; }
  header p, dt { margin: 0; color: #bba477; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  h1, h2 { margin: 0; font-family: Georgia, serif; font-weight: 400; }
  h1 { font-size: clamp(2.7rem, 7vw, 5rem); }
  header span, dd, .configuration { color: #cfc6b8; line-height: 1.5; }
  form { display: grid; gap: .75rem; max-width: 34rem; margin: 2.5rem 0 1rem; }
  label { font-size: .9rem; }
  input, button { min-height: 2.75rem; border: 1px solid #8f7652; border-radius: .25rem; font: inherit; }
  input { padding: .65rem .75rem; background: #191919; color: inherit; }
  button { padding: .65rem 1rem; background: #8f7652; color: #fff; cursor: pointer; }
  button:disabled { cursor: wait; opacity: .65; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .asset-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
  article { display: grid; grid-template-columns: 9rem minmax(0, 1fr); overflow: hidden; border: 1px solid #40382d; background: #181818; }
  .preview { background: #252019; aspect-ratio: 4 / 5; }
  .preview img { width: 100%; height: 100%; object-fit: cover; }
  .content { display: grid; align-content: start; gap: 1rem; padding: 1.25rem; }
  h2 { font-size: 1.55rem; }
  dl { display: grid; gap: .65rem; margin: 0; }
  dl div { display: grid; gap: .15rem; }
  dd { margin: 0; font-size: .88rem; }
  pre { overflow-wrap: anywhere; white-space: pre-wrap; margin: 2rem 0 0; padding: 1rem; border: 1px solid #40382d; background: #181818; }
  @media (max-width: 48rem) { .asset-grid { grid-template-columns: 1fr; } }
  @media (max-width: 30rem) { main { width: min(100% - 1rem, 76rem); padding-top: 1.5rem; } article { grid-template-columns: 1fr; } .preview { max-height: 16rem; } }
</style>
