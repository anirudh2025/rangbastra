<div class="loom-visual" data-hero-fallback aria-hidden="true">
  <picture class="loom-visual__master loom-visual__master--base">
    <source
      media="(max-width: 700px), (orientation: portrait)"
      type="image/avif"
      srcset="/images/hero/living-loom-mobile-master.avif"
    />
    <source
      media="(max-width: 700px), (orientation: portrait)"
      type="image/webp"
      srcset="/images/hero/living-loom-mobile-master.webp"
    />
    <source type="image/avif" srcset="/images/hero/living-loom-desktop-master.avif" />
    <img
      src="/images/hero/living-loom-desktop-master.webp"
      width="1672"
      height="941"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <picture class="loom-visual__master loom-visual__master--light">
    <source
      media="(max-width: 700px), (orientation: portrait)"
      type="image/avif"
      srcset="/images/hero/living-loom-mobile-master.avif"
    />
    <source
      media="(max-width: 700px), (orientation: portrait)"
      type="image/webp"
      srcset="/images/hero/living-loom-mobile-master.webp"
    />
    <source type="image/avif" srcset="/images/hero/living-loom-desktop-master.avif" />
    <img
      src="/images/hero/living-loom-desktop-master.webp"
      width="1672"
      height="941"
      alt=""
      decoding="async"
    />
  </picture>

  <svg
    class="loom-visual__construction"
    viewBox="0 0 430 932"
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
  >
    <path class="loom-visual__stitch" d="M216 236 C192 276 243 303 211 354" />
    <g class="loom-visual__structure">
      <path d="M216 224 C177 244 175 322 160 388 C143 470 116 610 88 828" />
      <path d="M216 224 C255 244 255 322 270 388 C287 470 314 610 342 828" />
      <path d="M171 335 C194 355 237 355 259 335" />
      <path d="M160 388 C196 407 236 407 270 388" />
    </g>
    <g class="loom-visual__connections">
      <path d="M180 268 C208 312 230 330 256 375" />
      <path d="M251 267 C223 314 203 333 174 380" />
      <path d="M163 388 C204 450 238 505 302 670" />
      <path d="M268 388 C228 456 197 518 124 694" />
    </g>
  </svg>

  <div class="loom-visual__warmth"></div>
  <div class="loom-visual__vignette"></div>
</div>

<style>
  .loom-visual {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
    pointer-events: none;
    user-select: none;
  }

  .loom-visual__master,
  .loom-visual__warmth,
  .loom-visual__vignette,
  .loom-visual__construction {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .loom-visual__master {
    display: block;
    opacity: var(--hero-master-opacity, .08);
    transform:
      translate3d(var(--hero-master-x, 0px), var(--hero-master-y, 0px), 0)
      scale(var(--hero-master-scale, 1.035));
    transform-origin: 50% 52%;
    transition: opacity 180ms linear;
    will-change: opacity, transform, filter;
  }

  .loom-visual__master img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    filter: brightness(var(--hero-master-brightness, .28)) saturate(.93);
    transform: translateY(4.2%);
  }

  .loom-visual__master--light {
    opacity: var(--hero-light-opacity, .02);
    mix-blend-mode: screen;
    mask-image: linear-gradient(
      112deg,
      transparent 20%,
      rgba(0, 0, 0, .2) 42%,
      #000 50%,
      rgba(0, 0, 0, .14) 58%,
      transparent 78%
    );
    transform:
      translate3d(calc(var(--hero-master-x, 0px) * -.45), var(--hero-master-y, 0px), 0)
      scale(calc(var(--hero-master-scale, 1.035) * 1.008));
  }

  .loom-visual__construction {
    display: none;
    fill: none;
    stroke: rgba(219, 165, 91, .74);
    stroke-width: .7;
    opacity: max(
      var(--hero-construction-opacity, 0),
      var(--hero-stitch-opacity, 0)
    );
    filter: drop-shadow(0 0 5px rgba(203, 146, 72, .24));
  }

  .loom-visual__construction path {
    vector-effect: non-scaling-stroke;
  }

  .loom-visual__stitch {
    opacity: var(--hero-stitch-opacity, 0);
    stroke-width: 1.1;
  }

  .loom-visual__structure {
    opacity: calc(var(--hero-construction-opacity, 0) * .72);
  }

  .loom-visual__connections {
    opacity: calc(var(--hero-construction-opacity, 0) * .48);
  }

  .loom-visual__warmth {
    background:
      radial-gradient(ellipse at 50% 36%, rgba(167, 101, 43, .13), transparent 34%),
      radial-gradient(ellipse at 50% 88%, rgba(99, 52, 25, .1), transparent 48%);
    opacity: var(--hero-light-opacity, .02);
    mix-blend-mode: screen;
  }

  .loom-visual__vignette {
    background:
      linear-gradient(90deg, rgba(0, 0, 0, .68), transparent 17%, transparent 83%, rgba(0, 0, 0, .64)),
      linear-gradient(0deg, #000 0%, transparent 19%, transparent 78%, rgba(0, 0, 0, .24) 100%);
  }

  :global([data-hero-mode="static"]) .loom-visual {
    --hero-master-opacity: 1;
    --hero-master-brightness: .92;
    --hero-light-opacity: .13;
  }

  @media (max-width: 700px), (orientation: portrait) {
    .loom-visual__master img {
      object-position: 50% 50%;
      transform: none;
    }

    .loom-visual__construction {
      display: block;
    }

    .loom-visual__vignette {
      background:
        linear-gradient(90deg, rgba(0, 0, 0, .42), transparent 20%, transparent 80%, rgba(0, 0, 0, .4)),
        linear-gradient(0deg, #000 0%, transparent 20%, transparent 68%, rgba(0, 0, 0, .34) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loom-visual__master {
      transform: none;
      transition: none;
    }

    .loom-visual__construction {
      display: none;
    }
  }
</style>

<noscript>
  <style>
    .loom-visual {
      --hero-master-opacity: 1;
      --hero-master-brightness: .92;
      --hero-master-scale: 1;
      --hero-light-opacity: .13;
    }
  </style>
</noscript>
