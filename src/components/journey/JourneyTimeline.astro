---
import { journey } from "../../data/journey";
import JourneyCard from "./JourneyCard.astro";
---

<div class="timeline" data-scroll-timeline data-replay-timeline>
  {
    journey.map((item, index) => (
      <div
        class:list={[
          "timeline-item",
          index % 2 === 0 ? "timeline-item--left" : "timeline-item--right",
        ]}
      >
        <JourneyCard
          step={item.id}
          title={item.title}
          description={item.description}
          icon={item.icon}
          image={item.image}
          revealSide={index % 2 === 0 ? "right" : "left"}
        />
      </div>
    ))
  }
</div>

<script>
  import { initTimelineProgress } from "../../lib/animations/timelineProgress";
  const initJourneyTimeline = () => {
    initTimelineProgress();
    document
      .querySelectorAll<HTMLElement>("[data-scroll-timeline]")
      .forEach((timeline) => {
        if (timeline.dataset.accordionReady) return;
        timeline.dataset.accordionReady = "true";
        const cards = [...timeline.querySelectorAll<HTMLElement>(".journey-card")];
        const milestones = [...timeline.querySelectorAll<HTMLElement>("[data-timeline-milestone]")];
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
        let cardObserver: IntersectionObserver | undefined;
        let milestoneTimers: number[] = [];
        let replayActive = false;
        const clearReplay = () => {
          if (!replayActive) return;
          replayActive = false;
          cardObserver?.disconnect();
          cardObserver = undefined;
          milestoneTimers.forEach(clearTimeout);
          milestoneTimers = [];
          timeline.classList.remove("is-active");
          timeline.style.setProperty("--timeline-progress", "0");
          cards.forEach((card) => card.classList.remove("is-revealed"));
          milestones.forEach((milestone) => milestone.classList.remove("is-complete", "is-current"));
        };
        const activateReplay = () => {
          if (replayActive) return;
          replayActive = true;
          timeline.classList.add("is-active");
          requestAnimationFrame(() => timeline.style.setProperty("--timeline-progress", "1"));
          if (reducedMotion) {
            cards.forEach((card) => card.classList.add("is-revealed"));
            milestones.forEach((milestone) => milestone.classList.add("is-complete"));
            milestones.at(-1)?.classList.add("is-current");
            return;
          }
          milestones.forEach((milestone, index) => {
            milestoneTimers.push(window.setTimeout(() => {
              milestone.classList.add("is-complete");
              milestone.classList.toggle("is-current", index === milestones.length - 1);
            }, 110 + index * 110));
          });
          if (!matchMedia("(min-width: 1024px)").matches) return;
          if (!("IntersectionObserver" in window)) {
            cards.forEach((card) => card.classList.add("is-revealed"));
            return;
          }
          cardObserver = new IntersectionObserver((entries, activeObserver) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              (entry.target as HTMLElement).classList.add("is-revealed");
              activeObserver.unobserve(entry.target);
            });
          }, { threshold: 0.2 });
          cards.forEach((card) => cardObserver?.observe(card));
        };
        const replayTarget = timeline.closest<HTMLElement>(".journey-section") ?? timeline;
        if ("IntersectionObserver" in window) {
          const sectionObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) activateReplay();
              else clearReplay();
            });
          }, { threshold: 0 });
          sectionObserver.observe(replayTarget);
          document.addEventListener("astro:before-swap", () => sectionObserver.disconnect(), { once: true });
        } else {
          activateReplay();
        }
        timeline
          .querySelectorAll<HTMLButtonElement>(".card-surface")
          .forEach((trigger) => {
            trigger.addEventListener("click", () => {
              if (!matchMedia("(max-width: 1023px)").matches) return;
              const card = trigger.closest<HTMLElement>(".journey-card");
              if (!card) return;
              const willOpen = trigger.getAttribute("aria-expanded") !== "true";
              timeline
                .querySelectorAll<HTMLElement>(".journey-card.is-expanded")
                .forEach((openCard) => {
                  if (openCard === card) return;
                  openCard.classList.remove("is-expanded");
                  const openTrigger = openCard.querySelector<HTMLButtonElement>(
                    ".card-surface",
                  );
                  openTrigger?.setAttribute("aria-expanded", "false");
                  openCard
                    .querySelector<HTMLElement>(".image-panel")
                    ?.setAttribute("aria-hidden", "true");
                  openCard
                    .querySelector<HTMLElement>(".mobile-image-panel")
                    ?.setAttribute("aria-hidden", "true");
                  if (openTrigger)
                    openTrigger.setAttribute(
                      "aria-label",
                      openTrigger.getAttribute("aria-label")?.replace("Hide", "Show") ?? "Show image",
                    );
                });
              card.classList.toggle("is-expanded", willOpen);
              trigger.setAttribute("aria-expanded", String(willOpen));
              const mobileImagePanel = card.querySelector<HTMLElement>(".mobile-image-panel");
              mobileImagePanel?.setAttribute("aria-hidden", String(!willOpen));
              if (willOpen) {
                const image = mobileImagePanel?.querySelector<HTMLImageElement>("img");
                if (image) image.loading = "eager";
              }
              trigger.setAttribute(
                "aria-label",
                trigger.getAttribute("aria-label")?.replace(
                  willOpen ? "Show" : "Hide",
                  willOpen ? "Hide" : "Show",
                ) ?? `${willOpen ? "Hide" : "Show"} image`,
              );
            });
          });
      });
  };
  initJourneyTimeline();
  document.addEventListener("astro:page-load", initJourneyTimeline);
</script>

<style>
  .timeline {
    --timeline-accent: rgb(var(--cocoa-rgb));
    --timeline-gutter: clamp(var(--space-7), 6vw, var(--space-12));
    --timeline-mobile-axis: var(--space-2);
    --timeline-mobile-content-offset: var(--space-6);
    --timeline-line-start: var(--space-6);
    --timeline-line-length: calc(100% - (var(--space-6) * 2));
    position: relative;
    display: grid;
    gap: clamp(var(--space-8), 7vw, var(--space-12));
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: var(--timeline-line-start);
    bottom: auto;
    height: var(--timeline-line-length);
    left: 50%;
    width: 1px;
    background: rgba(var(--cocoa-rgb), 0.26);
    box-shadow: none;
    transform: translateX(-50%);
  }

  .timeline::after {
    content: "";
    position: absolute;
    top: var(--timeline-line-start);
    bottom: auto;
    height: var(--timeline-line-length);
    left: 50%;
    width: 1.5px;
    background: var(--timeline-accent);
    box-shadow: 0 0 6px rgba(var(--cocoa-rgb), 0.32);
    transform: translate3d(-50%, 0, 0) scaleY(var(--timeline-progress, 0));
    transform-origin: top;
    pointer-events: none;
    will-change: transform;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-item {
    position: relative;
    width: 50%;
  }

  .timeline-item--left {
    justify-self: start;
    padding-right: var(--timeline-gutter);
  }

  .timeline-item--right {
    justify-self: end;
    padding-left: var(--timeline-gutter);
  }

  @media (max-width: 1023px) {
    .timeline {
      gap: var(--space-8);
    }

    .timeline::before {
      left: var(--timeline-mobile-axis);
      transform: none;
    }
    .timeline::after {
      left: var(--timeline-mobile-axis);
      transform: scaleY(var(--timeline-progress, 0));
    }

    .timeline-item,
    .timeline-item--left,
    .timeline-item--right {
      width: 100%;
      justify-self: stretch;
      padding-inline: 0 0;
      padding-left: var(--timeline-mobile-content-offset);
    }
  }

  @media (max-width: 767px) {
    .timeline {
      gap: var(--space-7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline::after {
      transition: none;
    }
  }
</style>
