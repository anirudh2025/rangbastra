---
interface Props { name: string; slug: string; description?: string; }
const { name, slug, description = "Discover this Rangbastra couture piece." } = Astro.props;
---

<span class="card-share-control" data-card-share-control>
  <button
    type="button"
    data-card-share
    data-share-path={`/products/${slug}`}
    data-share-title={name}
    data-share-description={description}
    aria-label={`Share ${name}`}
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" focusable="false">
      <path d="M8.2 11.1 15.6 7M8.2 12.9l7.4 4.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="6.2" cy="12" r="2.15" fill="currentColor" />
      <circle cx="17.8" cy="5.8" r="2.15" fill="currentColor" />
      <circle cx="17.8" cy="18.2" r="2.15" fill="currentColor" />
    </svg>
  </button>
  <span class="card-share-feedback" role="status" aria-live="polite" data-card-share-status></span>
</span>

<script>
  const shareFeedback = (button: HTMLButtonElement, message: string) => {
    const status = button.closest<HTMLElement>("[data-card-share-control]")?.querySelector<HTMLElement>("[data-card-share-status]");
    if (!status) return;
    status.textContent = message;
    window.setTimeout(() => { if (status.textContent === message) status.textContent = ""; }, 2600);
  };

  const copyShareUrl = async (url: string) => {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(url);
        return;
      }
    } catch {
      // Clipboard permissions can fail on localhost; use the safe legacy path.
    }
    const input = document.createElement("textarea");
    input.value = url;
    input.setAttribute("readonly", "");
    input.style.cssText = "position:fixed;inset:auto;opacity:0;pointer-events:none";
    document.body.append(input);
    input.select();
    const copied = document.execCommand("copy");
    input.remove();
    if (!copied) throw new Error("Copy failed");
  };

  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>("[data-card-share]");
    if (!button) return;
    event.preventDefault();
    event.stopPropagation();

    const url = new URL(button.dataset.sharePath || location.pathname, location.origin).toString();
    const shareData = { title: button.dataset.shareTitle || document.title, text: button.dataset.shareDescription || "", url };
    try {
      if (navigator.share) {
        await navigator.share(shareData);
        shareFeedback(button, "Shared");
        return;
      }
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
    }

    try {
      await copyShareUrl(url);
      shareFeedback(button, "Link copied");
    } catch {
      shareFeedback(button, "Unable to share");
    }
  });
</script>

<style>
  .card-share-control{position:absolute;top:var(--space-4);right:calc(var(--space-4) + 3.5rem + var(--space-1));z-index:3;display:grid;place-items:center;width:2.75rem;height:2.75rem}.card-share-control button{display:grid;width:2.35rem;height:2.35rem;place-items:center;padding:0;border:1px solid rgba(255,255,255,.12);border-radius:50%;background:rgba(3,3,3,.62);color:var(--text-muted);cursor:pointer;backdrop-filter:blur(12px)}.card-share-control button:hover{border-color:var(--cocoa-border);background:rgba(3,3,3,.82);color:var(--text-secondary)}.card-share-control button:focus-visible{outline:2px solid var(--focus-ring);outline-offset:3px}.card-share-feedback{position:absolute;top:calc(100% + var(--space-1));right:0;min-width:max-content;max-width:10rem;padding:.3rem .45rem;border:1px solid var(--cocoa-border-soft);background:rgba(3,3,3,.94);color:var(--ivory-100);font-size:.68rem;line-height:1.35;pointer-events:none}.card-share-feedback:empty{display:none}@media(max-width:767px){.card-share-control{right:calc(var(--space-3) + 3.25rem + var(--space-1))}}@media(max-width:350px){.card-share-control{right:calc(var(--space-3) + 3.15rem + var(--space-1))}}
</style>
