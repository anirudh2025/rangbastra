---
import Label from "../primitives/Label.astro";
import Eyebrow from "../primitives/Eyebrow.astro";
import Icon from "../primitives/Icon.astro";
import WishlistButton from "../wishlist/WishlistButton.astro";
import CoutureCardColour from "./CoutureCardColour.astro";
import CoutureCardShare from "./CoutureCardShare.astro";
import type { CouturePiece } from "../../data/couture";
import { getCloudinaryImageUrl, getProductCoverImage, isConfirmedFourByFive } from "../../lib/couture";

interface Props { product: CouturePiece; index: number; animateEntrance?: boolean; }
const { product, index, animateEntrance = false } = Astro.props;
const loading = index < 4 ? "eager" : "lazy";
const cover = getProductCoverImage(product);
const confirmedFourByFive = isConfirmedFourByFive(cover);
---

<article class:list={["product-card", product.featured && "product-card--featured", animateEntrance && "product-card--staged"]} data-category={product.category} data-category-id={product.collectionIds[0]} data-featured-stage={animateEntrance ? index + 1 : undefined} style={`--product-card-delay:${Math.min(index, 8) * 150}ms`}>
  <div class="product-media">
    <a href={`/products/${product.slug}`} class="product-media__link" data-product-link data-track="product_opened" data-product={product.slug} data-category={product.category} aria-label={`Explore ${product.name}`}>
      <img data-image-fit={confirmedFourByFive ? "cover" : "contain"} src={getCloudinaryImageUrl(cover.src, 900)} alt={cover.alt} width={cover.width ?? 900} height={cover.height ?? 1125} loading={loading} decoding="async" />
    </a>
    <CoutureCardShare name={product.name} slug={product.slug} />
    <WishlistButton slug={product.slug} name={product.name} />
  </div>

  <div class="product-copy">
    <div class="product-kicker"><Eyebrow>{product.category}</Eyebrow></div>
    <h2><a href={`/products/${product.slug}`} data-product-link data-track="product_opened" data-product={product.slug}>{product.name}<Icon name="sparkle" size={16} class="card-title-sparkle" /></a></h2>
    <p class="product-description">{product.shortDescription}</p>
    <div class="product-price" aria-label={product.startingPrice ? `Starting at ${product.priceLabel}` : product.priceLabel}>{product.startingPrice && <span>Starting at</span>}<strong>{product.priceLabel}</strong></div>
    <CoutureCardColour name={product.name} slug={product.slug} mode={product.colourMode} options={product.paletteOptions} />
    <ul class="craft-tags" aria-label={`${product.name} keywords`}>{product.publicKeywords.map((keyword) => <li>{keyword}</li>)}</ul>
    <a href={`/products/${product.slug}`} class="product-action" data-product-link data-track="product_opened" data-product={product.slug}><Label icon="journal" iconPosition="right" iconSize={14}>Explore Piece</Label></a>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>(".product-card").forEach((card) => {
    if (card.dataset.paletteLinksReady) return;
    card.dataset.paletteLinksReady = "true";
    card.addEventListener("rangbastra:palette-selected", (event) => {
      const selection = (event as CustomEvent<{ slug: string; id: string; custom: string }>).detail;
      card.querySelectorAll<HTMLAnchorElement>("[data-product-link]").forEach((link) => {
        const url = new URL(link.href, location.origin);
        url.searchParams.set("palette", selection.id);
        if (selection.custom) url.searchParams.set("customColour", selection.custom); else url.searchParams.delete("customColour");
        link.href = `${url.pathname}${url.search}`;
      });
    });
  });
</script>

<style>
  .product-card{--product-card-radius:var(--radius-xl);position:relative;display:grid;grid-template-rows:auto 1fr;gap:var(--space-6);height:100%;min-width:0;opacity:1;transform:none}.product-card--staged{opacity:0;transform:translateY(130px);transition:opacity 900ms cubic-bezier(.22,1,.36,1) var(--product-card-delay),transform 1050ms cubic-bezier(.22,1,.36,1) var(--product-card-delay)}.product-card--staged.is-settled{opacity:1;transform:none}.product-media{position:relative;overflow:hidden;aspect-ratio:4/5;border:1px solid var(--border-default);border-radius:var(--product-card-radius);background:var(--surface-raised);box-shadow:var(--shadow-premium),var(--shadow-inset);transition:transform var(--motion-medium) var(--ease-luxury),border-color var(--motion-medium) var(--ease-luxury),box-shadow var(--motion-medium) var(--ease-luxury)}.product-media__link{display:block;height:100%}.product-media img{width:100%;height:100%;object-fit:contain;object-position:center;transform:scale(1);transition:transform var(--motion-image) var(--ease-luxury)}.product-media img[data-image-fit="cover"]{object-fit:cover}.product-media::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 46%,rgba(0,0,0,.7)),var(--gradient-glass);opacity:.72;transition:opacity var(--motion-medium) var(--ease-luxury)}.product-copy{display:grid;grid-template-rows:auto minmax(4.1rem,auto) minmax(calc(2 * var(--leading-body) * 1em),auto) minmax(3.75rem,auto) minmax(5rem,auto) minmax(5.5rem,auto) auto;align-content:start;gap:var(--space-3);min-width:0;padding:var(--space-1) var(--space-1) 0}.product-kicker{display:flex;min-height:2rem;align-items:start}.product-kicker :global(.eyebrow){border:1px solid rgba(var(--cocoa-rgb),.38);border-radius:var(--radius-2xs);background:rgba(var(--cocoa-rgb),.12);color:var(--text-secondary);box-shadow:none}h2{min-width:0;margin:0;font-family:var(--font-signature);font-size:clamp(1.85rem,2.35vw,2.85rem);font-weight:var(--weight-regular);line-height:1.28}h2 a{display:inline-flex;align-items:center;gap:var(--space-2);max-width:13ch;color:var(--text-primary);text-decoration:none}h2 a:focus-visible{outline:2px solid var(--focus-ring);outline-offset:4px}.card-title-sparkle{flex:0 0 auto;color:rgb(var(--cocoa-rgb));opacity:.72}p{margin:0;max-width:var(--measure-xs);color:var(--text-secondary);font-size:var(--body-sm);line-height:var(--leading-body);text-wrap:pretty}.product-description{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2}.product-price{display:grid;align-content:start;gap:var(--space-1);color:var(--text-primary);font-family:var(--font-body);font-variant-numeric:tabular-nums;line-height:1.25}.product-price span{color:var(--text-muted);font-size:var(--caption);font-weight:var(--weight-semibold);letter-spacing:var(--tracking-label);text-transform:uppercase}.product-price strong{font-size:clamp(1.15rem,1.6vw,1.42rem);font-weight:700}.craft-tags{display:flex;align-content:start;flex-wrap:wrap;gap:var(--space-2);min-width:0;padding:0;margin:0;list-style:none}.craft-tags li{display:inline-flex;min-height:2rem;align-items:center;padding:.35rem .65rem;border:1px solid var(--cocoa-border-soft);border-radius:var(--radius-2xs);background:rgba(var(--cocoa-rgb),.08);color:var(--text-muted);font-size:var(--caption);line-height:var(--leading-caption);text-align:center}.product-action{display:inline-flex;align-self:end;width:fit-content;min-height:2.75rem;align-items:center;justify-content:center;padding-inline:var(--space-4);border:1px solid var(--border-default);border-radius:var(--radius-md);background:rgba(255,255,255,.02);color:var(--ivory-100);text-decoration:none;transition:background var(--motion-medium) var(--ease-luxury),border-color var(--motion-medium) var(--ease-luxury),transform var(--motion-medium) var(--ease-luxury)}.product-media:hover,.product-media:focus-within{transform:translate3d(0,var(--motion-card-lift),0);border-color:var(--border-strong);box-shadow:var(--shadow-premium),var(--glow-soft),var(--shadow-inset-strong)}.product-media:hover::after,.product-media:focus-within::after{opacity:.5}.product-media:hover img[data-image-fit="cover"],.product-media:focus-within img[data-image-fit="cover"]{transform:scale(var(--motion-image-scale-subtle))}h2 a:hover,.product-action:hover{color:var(--ivory-50)}.product-action:hover,.product-action:focus-visible{border-color:var(--border-strong);background:rgba(255,255,255,.045);transform:translate3d(var(--motion-distance-xs),0,0)}.product-action:focus-visible{outline:2px solid var(--focus-ring);outline-offset:var(--space-2)}@media(max-width:767px){.product-card{--product-card-radius:var(--radius-lg);gap:var(--space-5)}.product-copy{grid-template-rows:auto minmax(3.6rem,auto) minmax(calc(2 * var(--leading-body) * 1em),auto) minmax(3.5rem,auto) minmax(5rem,auto) minmax(5.5rem,auto) auto;gap:var(--space-2)}h2{font-size:clamp(1.45rem,8vw,2.15rem)}p{font-size:.86rem}}@media(prefers-reduced-motion:reduce){.product-card,.product-card--staged,.product-media,.product-media:hover,.product-media:focus-within,.product-media img,.product-action,.product-action:hover,.product-action:focus-visible{transform:none;transition:none}}
</style>
